# Copy to .env and fill in. Never commit the real .env.
# The Streamlit UI provides a friendlier way to enter these — see HOW_TO_RUN.md.

# ---- Jira ----
JIRA_HOST=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token

# ---- Claude authentication mode ----
# subscription: route calls through Claude Code (`claude /login` required);
#               usage counts against your Claude.ai (Max/Pro) plan.
# api:          call the Anthropic API directly; requires ANTHROPIC_API_KEY.
CLAUDE_AUTH_MODE=subscription

# Only needed if CLAUDE_AUTH_MODE=api
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# Extended thinking — Claude reasons before answering for higher-quality
# analysis. Budget is how many tokens Claude is allowed to think. Higher
# budget = better quality but slower and more tokens. Disable by setting
# CLAUDE_EXTENDED_THINKING=false.
CLAUDE_EXTENDED_THINKING=true
CLAUDE_THINKING_BUDGET=4096

# ---- Vector store ----
VECTOR_DB=chroma
# If switching to Pinecone, set these:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- Optional Redis cache ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- RAG tunables ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=5
MIN_TEST_CASES_PER_TICKET=5
MAX_TEST_CASES_PER_TICKET=15
